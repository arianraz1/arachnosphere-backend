# ==============================================================
#  Environment Variables for Arachnosphere Backend
#  Copy this file to .env and fill in the actual values
# ==============================================================

# ==============================================================
#  Database Configuration
# ==============================================================
DB_PASSWORD=your_secure_database_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tarantula_db

# ==============================================================
#  JWT Configuration
# ==============================================================
# Generate a secure random key (at least 32 bytes) for production
# Use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_minimum_32_bytes_long

# ==============================================================
#  Cookie Configuration
# ==============================================================
# Set to 'true' in production when using HTTPS
COOKIE_SECURE=false

# Set to your actual domain in production (e.g., arachnosphere.com)
COOKIE_DOMAIN=localhost

# ==============================================================
#  CORS Configuration
# ==============================================================
# Set to your frontend URL in production (e.g., https://arachnosphere.com)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ==============================================================
#  Admin Configuration
# ==============================================================
# User ID that will be granted ROLE_ADMIN
ADMIN_USER_ID=1

# ==============================================================
#  SendGrid Email Configuration
# ==============================================================
# Get your API key from https://dashboard.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Verified sender email in SendGrid
SENDGRID_FROM_EMAIL=noreply@arachnosphere.com

# Sender name that appears in emails
SENDGRID_FROM_NAME=Arachnosphere

# ==============================================================
#  Application Configuration
# ==============================================================
# Backend URL used for email verification links
APP_BASE_URL=http://localhost:8080

# ==============================================================
#  Spring Profile
# ==============================================================
# Use 'prod' for production deployment
SPRING_PROFILES_ACTIVE=prod

# ==============================================================
# AWS S3 Local Configuration
# ==============================================================
AWS_S3_BUCKET=tarantula-images-local
AWS_S3_REGION=us-east-1
# Leave blank if connecting to real AWS, or set to http://localhost:4566 for LocalStack
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_ENDPOINT_URL=

LOCALSTACK_AUTH_TOKEN=